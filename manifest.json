{
  "manifest_version": 3,
  "name": "Hangly",
  "version": "1.0.0",
  "description": "Add physically-simulated interactive hanging charms to any webpage.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Hangly",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["scripting", "activeTab", "storage", "unlimitedStorage"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["images/images.png", "images/images1.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
